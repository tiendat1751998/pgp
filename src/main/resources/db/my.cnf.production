# ============================================================
# MYSQL/MARIADB PRODUCTION CONFIGURATION
# For 10K TPS ISO8583 Workload
# ============================================================

# ============================================================
# [mysqld] - Server Section
# ============================================================

# -----------------------
# Basic Settings
# -----------------------
server-id = 1
port = 3306
datadir = /var/lib/mysql
socket = /var/run/mysqld/mysqld.sock
pid-file = /var/run/mysqld/mysqld.pid

# -----------------------
# Character Set
# -----------------------
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
init-connect = 'SET NAMES utf8mb4'

# -----------------------
# Binary Logging (PITR & Replication)
# -----------------------
log_bin = /var/log/mysql/mariadb-bin
binlog_format = ROW
binlog_row_image = FULL
binlog_checksum = CRC32
expire_logs_days = 7
max_binlog_size = 100M
sync_binlog = 1

# -----------------------
# InnoDB Settings (CRITICAL for Performance)
# -----------------------
innodb_buffer_pool_size = 4G           # 70-80% of RAM
innodb_log_file_size = 1G              # Large for write-heavy
innodb_log_buffer_size = 64M           # Reduce disk sync
innodb_flush_log_at_trx_commit = 1     # Full durability (ACID)
innodb_flush_method = O_DIRECT         # Bypass OS cache
innodb_file_per_table = 1              # Better management
innodb_io_capacity = 2000              # SSD high IOPS
innodb_io_capacity_max = 4000
innodb_read_io_threads = 8
innodb_write_io_threads = 8
innodb_thread_concurrency = 0          # Unlimited (use CPU cores)

# -----------------------
# Transaction Isolation (Financial Compliance)
# -----------------------
transaction-isolation = READ-COMMITTED
innodb_lock_wait_timeout = 50          # Detect deadlocks faster

# -----------------------
# Connection Settings
# -----------------------
max_connections = 300                  # Based on CPU cores
thread_cache_size = 50                 # Reuse threads
table_open_cache = 4000               # Cache table definitions
table_definition_cache = 2000
max_connect_errors = 100000
connect_timeout = 10
wait_timeout = 600
interactive_timeout = 600

# -----------------------
# Query Cache (MariaDB 10.1+ - Disabled in 10.4+)
# -----------------------
# query_cache_type = 0                # Disabled in modern versions
# query_cache_size = 0

# -----------------------
# Temp Tables & Sort Buffer
# -----------------------
tmp_table_size = 256M
max_heap_table_size = 256M
sort_buffer_size = 2M
read_buffer_size = 2M
read_rnd_buffer_size = 4M
join_buffer_size = 2M

# -----------------------
# Slow Query Log
# -----------------------
slow_query_log = 1
slow_query_log_file = /var/log/mysql/mariadb-slow.log
long_query_time = 1                   # Log queries > 1s
log_queries_not_using_indexes = 1    # Warn on full scans

# -----------------------
# Performance Schema (MySQL 5.5+, MariaDB 10.0+)
# -----------------------
performance_schema = ON
performance_schema_instrument = '%=ON'
performance_schema_consumer_events_statements_history = ON

# -----------------------
# Security
# -----------------------
bind-address = 0.0.0.0               # Or specific IP
local_infile = 0                      # Disable LOAD DATA
skip_symbolic_links = 1              # Security
secure_file_priv = /var/lib/mysql-files  # Import restriction

# -----------------------
# InnoDB Checksum (Data Integrity)
# -----------------------
innodb_checksum_algorithm = crc32
innodb_log_checksums = 1

# -----------------------
# Doublewrite Buffer (Crash Recovery)
# -----------------------
innodb_doublewrite = 1

# ============================================================
# [client] - Client Section
# ============================================================
[client]
port = 3306
socket = /var/run/mysqld/mysqld.sock
default-character-set = utf8mb4

# ============================================================
# [mysql] - MySQL CLI
# ============================================================
[mysql]
default-character-set = utf8mb4

# ============================================================
# PARAMETER RECOMMENDATIONS BY WORKLOAD
# ============================================================

-- For 10K TPS (High Write):
-- - innodb_buffer_pool_size: 8G (if RAM 16GB+)
-- - innodb_log_file_size: 2G
-- - innodb_io_capacity: 4000
-- - sync_binlog = 1 (full durability)
-- - max_connections: 300

-- For Read-Heavy (Reporting):
-- - innodb_buffer_pool_size: 12G
-- - read_only = 1
-- - query_cache_type = 1 (if MariaDB 10.3)

-- For Mixed (OLTP + OLAP):
-- - innodb_buffer_pool_size: 10G
-- - Use read replicas for queries
-- - Implement connection pooling